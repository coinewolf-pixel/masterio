# ───────── Masterio API ─────────
# Скопируйте в .env и заполните. Настоящие ключи никогда не коммитьте.

# development | test | production
NODE_ENV=development
# Порт HTTP и WebSocket (Railway подставляет свой PORT автоматически)
PORT=3000
# Публичный адрес API (для ссылок в письмах и webhooks)
PUBLIC_URL=http://localhost:3000
# Разрешённые источники для CORS и Socket.IO через запятую (адрес админки)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL 16 с расширением PostGIS
DATABASE_URL=postgresql://masterio:masterio@localhost:5432/masterio
# Redis 7 (очереди BullMQ, таймеры предложений, Socket.IO, лимиты). Включите AOF/persistence.
REDIS_URL=redis://localhost:6379
# Запускать обработчики очередей в этом процессе (true). На Railway можно выделить отдельный сервис-воркер.
QUEUE_WORKERS_ENABLED=true

# Секрет подписи access JWT, минимум 32 символа: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Срок жизни access-токена, секунды
JWT_ACCESS_TTL_SECONDS=900
# Срок жизни refresh-токена, дни (ротация при каждом обновлении)
JWT_REFRESH_TTL_DAYS=30
# Ключ шифрования персональных данных, ровно 32 байта в base64: openssl rand -base64 32
PII_ENCRYPTION_KEY=

# SMS-коды: twilio (обязательно в production) или console (код печатается в лог, только разработка)
SMS_PROVIDER=console
# Twilio Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Console → Verify → Services → Service SID (начинается с VA)
TWILIO_VERIFY_SERVICE_SID=

# Push: expo (Expo Push Service, рекомендуется для приложений Masterio и Masterio Pro), fcm (напрямую Firebase) или log (только разработка)
PUSH_PROVIDER=log
# Необязательный токен Expo Push (если в проекте EAS включена Enhanced Security)
EXPO_ACCESS_TOKEN=
# JSON сервисного аккаунта Firebase в base64: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Stripe: секретный ключ (sk_test_… / sk_live_…) для пополнения баланса мастеров
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → Signing secret (whsec_…), endpoint: /api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# S3-совместимое хранилище для фото заказов и документов (закрытый бакет, ссылки на 5 минут).
# AWS S3: endpoint пустой. Локально (docker compose): http://localhost:9000 (MinIO).
# Хранилище должно поддерживать presigned POST (загрузка с ограничением размера). Cloudflare R2 его не поддерживает.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=masterio
S3_ACCESS_KEY_ID=masterio
S3_SECRET_ACCESS_KEY=masterio-secret
# true для MinIO и большинства S3-совместимых сервисов
S3_FORCE_PATH_STYLE=true
# создать бакет при старте, если его нет (только для разработки)
S3_CREATE_BUCKET=true

# Google Maps Platform (серверный ключ, ограничьте по IP Railway): Routes API — ETA с пробками,
# Places API (New) и Geocoding API — поиск адресов в Masterio. Без ключа ETA считается по прямой, а адрес выбирается на карте и по GPS.
GOOGLE_MAPS_API_KEY=
# Sentry DSN для ошибок сервера (необязательно)
SENTRY_DSN=
# error | warn | log | debug | verbose
LOG_LEVEL=log

# Первый superadmin, создаётся командой seed (TOTP-ссылка печатается в консоль один раз)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_COUNTRY=AM

# ───────── Проверка в App Store и Google Play ─────────
# Номера тестовых аккаунтов (E.164, через запятую): SMS не отправляется, вход по REVIEW_OTP_CODE.
# Их заказы получают только такие же тестовые мастера — реальные пользователи их не видят. После проверки уберите.
REVIEW_PHONES=
# 6 случайных цифр (не 123456 и не одинаковые) — сообщите их проверяющим в App Store Connect и Play Console
REVIEW_OTP_CODE=
