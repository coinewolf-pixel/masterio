# ───────── Masterio CRM (веб-админка) ─────────
# Переменные VITE_* встраиваются в собранные файлы и видны в браузере — секретов здесь быть не должно.

# Адрес API: https://<домен API на Railway>/api/v1 (этот адрес админки добавьте в CORS_ORIGINS сервера)
VITE_API_URL=http://localhost:3000/api/v1
# Подложка живой карты (растровые тайлы). Публичные тайлы OpenStreetMap годятся только для разработки и небольшой нагрузки;
# в продакшене используйте сервис с ключом (MapTiler, Stadia Maps, Thunderforest), например:
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=<ключ, ограниченный доменом админки>
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
