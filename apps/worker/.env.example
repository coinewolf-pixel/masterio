# ───────── Masterio Pro (приложение мастера) ─────────
# Переменные EXPO_PUBLIC_* попадают в сборку приложения — секретов здесь быть не должно.

# Адрес API (Railway): https://<домен>/api/v1 ; локально с эмулятора Android: http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Публичный ключ Stripe (pk_test_… / pk_live_…) для пополнения баланса
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple Pay: Merchant ID из Apple Developer (необязательно)
EXPO_PUBLIC_APPLE_MERCHANT_ID=
# Ключ Google Maps SDK for Android (для превью карты в приложении, ограничьте по SHA-1 и имени пакета)
GOOGLE_MAPS_ANDROID_API_KEY=
# EAS: id проекта Expo (eas init) — нужен для push-токенов Expo/FCM
EAS_PROJECT_ID=
